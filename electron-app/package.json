{
  "name": "draw-sync",
  "version": "1.0.0",
  "description": "Android 平板绘图实时同步到 Windows",
  "main": "dist/main/main.js",
  "scripts": {
    "postcompile": "cp -r src/renderer/*.html src/renderer/*.css dist/renderer/ 2>/dev/null; exit 0",
    "build": "tsc && npm run postcompile && electron-builder",
    "start": "tsc && npm run postcompile && electron ."
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "chokidar": "^4.0.0",
    "concurrently": "^9.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "5.6.3"
  }
}
